{
  "name": "jpcuuts-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test worker/*.test.js scripts/*.test.cjs",
    "test:foundation": "node scripts/foundation-e2e.cjs",
    "test:chair": "node scripts/chair-visual-check.cjs",
    "test:jp-feedback": "node scripts/jp-feedback-check.cjs",
    "test:jp-isolation": "node scripts/jp-isolation-check.cjs",
    "cf:dev": "npm run build && wrangler dev",
    "cf:migrate:local": "wrangler d1 migrations apply numbered-preview-dev-db --local",
    "cf:migrate:remote": "wrangler d1 migrations apply numbered-preview-dev-db --remote",
    "cf:deploy:dev": "npm run build && wrangler deploy --config wrangler.dev.toml",
    "cf:deploy:production": "npm run build && wrangler deploy --config wrangler.toml",
    "preview": "vite preview"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "lucide-react": "^1.18.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
